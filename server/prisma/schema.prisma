datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdPayruns Payrun[] @relation("PayrunCreator")
  correctedAttendances Attendance[] @relation("AttendanceCorrector")
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique // "Employee", "HR Manager", "HR Payroll User", "HR Payroll Manager", "Admin"
  userRoles UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Department {
  id          String        @id @default(uuid())
  name        String        @unique
  managerId   String?
  manager     Employee?     @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees   Employee[]    @relation("DepartmentEmployees")
  contracts   Contract[]
  jobPositions JobPosition[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model JobPosition {
  id           String      @id @default(uuid())
  title        String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]
  contracts    Contract[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([title, departmentId])
}

model Employee {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  phone               String?
  avatarUrl           String?
  bankAccountNumber   String?
  bankName            String?
  bankIfsc            String?
  panNumber           String?
  departmentId        String?
  department          Department?      @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managerId           String?
  manager             Employee?        @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates        Employee[]       @relation("EmployeeHierarchy")
  managedDepartments  Department[]     @relation("DepartmentManager")
  jobPositionId       String?
  jobPosition         JobPosition?     @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  workingScheduleId   String?
  workingSchedule     WorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  status              String           @default("active") // "active", "inactive"
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User?
  contracts           Contract[]
  attendances         Attendance[]
  timeOffRequests     TimeOffRequest[]
  timeOffAllocations  TimeOffAllocation[]
  payslips            Payslip[]
}

model WorkingSchedule {
  id                String                @id @default(uuid())
  name              String
  calendarType      String                @default("standard")
  companyId         String?
  status            String                @default("active")
  totalWeeklyHours  Decimal               @default(40.0) @db.Decimal(5, 2)
  lines             WorkingScheduleLine[]
  employees         Employee[]
  contracts         Contract[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model WorkingScheduleLine {
  id           String          @id @default(uuid())
  scheduleId   String
  schedule     WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek    Int             // 0=Sun, 1=Mon, ..., 6=Sat
  startTime    String          // "09:00"
  endTime      String          // "18:00"
  breakMinutes Int             @default(60)

  @@index([scheduleId])
}

model Contract {
  id                String           @id @default(uuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate         DateTime
  endDate           DateTime?
  wagePerMonth      Decimal          @db.Decimal(12, 2)
  status            String           @default("draft") // "draft", "running", "expired"
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPositionId     String?
  jobPosition       JobPosition?     @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  payslips          Payslip[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId, status])
}

model Attendance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkIn       DateTime
  checkOut      DateTime?
  workedHours   Decimal?  @db.Decimal(5, 2)
  status        String    @default("normal") // "normal", "exception"
  correctedById String?
  correctedBy   User?     @relation("AttendanceCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, checkIn])
}

model TimeOffType {
  id                 String              @id @default(uuid())
  name               String              @unique
  unit               String              @default("days") // "days", "hours"
  requiresAllocation Boolean             @default(true)
  approvalFlow       String              @default("manager") // "manager", "hr"
  affectsPayroll     Boolean             @default(true)
  allocations        TimeOffAllocation[]
  requests           TimeOffRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model TimeOffAllocation {
  id              String           @id @default(uuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId   String
  timeOffType     TimeOffType      @relation(fields: [timeOffTypeId], references: [id], onDelete: Cascade)
  allocatedAmount Decimal          @db.Decimal(5, 2)
  takenAmount     Decimal          @default(0.00) @db.Decimal(5, 2)
  remainingAmount Decimal          @db.Decimal(5, 2)
  validFrom       DateTime
  validTo         DateTime
  status          String           @default("approved") // "pending", "approved"
  requests        TimeOffRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([employeeId, timeOffTypeId])
}

model TimeOffRequest {
  id             String             @id @default(uuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffTypeId  String
  timeOffType    TimeOffType        @relation(fields: [timeOffTypeId], references: [id], onDelete: Cascade)
  allocationId   String?
  allocation     TimeOffAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  startDate      DateTime
  endDate        DateTime
  durationAmount Decimal            @db.Decimal(5, 2)
  status         String             @default("draft") // "draft", "submitted", "approved", "refused"
  reason         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([employeeId, status])
}

model SalaryStructure {
  id                   String                @id @default(uuid())
  name                 String                @unique
  isActive             Boolean               @default(true)
  contracts            Contract[]
  payruns              Payrun[]
  salaryStructureRules SalaryStructureRule[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model SalaryRule {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique // e.g. "BASIC", "HRA", "GROSS", "PF", "TAX", "NET"
  category             String                // "basic", "allowance", "gross", "deduction", "net"
  sequence             Int
  computationMethod    String                // "fixed", "percentage", "formula"
  amount               Decimal?              @db.Decimal(12, 2)
  percentageOf         String?               // e.g. "BASIC", "GROSS"
  formula              String?               // e.g. "BASIC * 0.12"
  salaryStructureRules SalaryStructureRule[]
  payslipLines         PayslipLine[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model SalaryStructureRule {
  id          String          @id @default(uuid())
  structureId String
  ruleId      String
  sequence    Int
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  rule        SalaryRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([structureId, ruleId])
  @@index([structureId, sequence])
}

model Payrun {
  id                String          @id @default(uuid())
  name              String
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  periodStart       DateTime
  periodEnd         DateTime
  status            String          @default("draft") // "draft", "computed", "validated", "paid"
  createdById       String?
  createdBy         User?           @relation("PayrunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  payslips          Payslip[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([periodStart, periodEnd])
}

model Payslip {
  id             String        @id @default(uuid())
  payrunId       String
  payrun         Payrun        @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractId     String
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  periodStart    DateTime
  periodEnd      DateTime
  workedDays      Decimal       @default(30.0) @db.Decimal(5, 2)
  targetHours     Decimal       @default(160.00) @db.Decimal(7, 2)
  attendanceHours Decimal       @default(0.00) @db.Decimal(7, 2)
  regularHours    Decimal       @default(0.00) @db.Decimal(7, 2)
  overtimeHours   Decimal       @default(0.00) @db.Decimal(7, 2)
  overtimeAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  grossSalary     Decimal       @default(0.00) @db.Decimal(12, 2)
  netSalary       Decimal       @default(0.00) @db.Decimal(12, 2)
  status          String        @default("draft") // "draft", "done", "paid"
  hasWarning      Boolean       @default(false)
  warningMessage  String?
  sentAt          DateTime?
  lines           PayslipLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([payrunId, employeeId])
  @@index([employeeId, periodStart, periodEnd])
}

model PayslipLine {
  id           String      @id @default(uuid())
  payslipId    String
  payslip      Payslip     @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRuleId String?
  salaryRule   SalaryRule? @relation(fields: [salaryRuleId], references: [id], onDelete: SetNull)
  label        String
  code         String
  category     String      // "basic", "allowance", "gross", "deduction", "net"
  amount       Decimal     @db.Decimal(12, 2)
  sequence     Int

  @@index([payslipId, sequence])
}
