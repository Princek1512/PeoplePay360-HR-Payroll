# Database Configuration (supports local or Cloud PostgreSQL e.g., Neon.tech, Supabase, Railway)
# Example Cloud (Neon): postgresql://user:password@ep-cool-cloud.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/peoplepay360?schema=public"

# Server Port
PORT=5000

# JWT Secrets for Auth
JWT_SECRET="peoplepay360_super_secret_jwt_access_token_key_2026"
